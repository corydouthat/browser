{
  "name": "hatch-harness",
  "version": "1.0.0",
  "private": true,
  "description": "Hatch detection harness: static probe page + vendored detector libraries + headless Firefox runner deps.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "vendor-build": "node tool/build-vendor.mjs",
    "vendor-check": "node tool/build-vendor.mjs --check",
    "gen-expectations": "node ../tool/headless/gen-expectations.mjs",
    "serve": "node ../tool/headless/server.mjs",
    "headless": "node ../tool/headless/run.mjs"
  },
  "dependencies": {
    "bowser": "2.14.1",
    "detect-it": "4.0.1",
    "device-detector-js": "3.0.3",
    "is-mobile": "5.0.0",
    "ismobilejs": "1.1.1",
    "mobile-detect": "1.4.5",
    "platform": "1.3.6",
    "react": "18.3.1",
    "react-device-detect": "2.2.3",
    "react-dom": "18.3.1",
    "ua-parser-js": "2.0.10"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "modernizr": "3.13.1",
    "selenium-webdriver": "4.51.0"
  },
  "engines": {
    "node": ">=22"
  }
}
